{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryanflash66/dealersource/evals/contract/report.schema.json",
  "title": "dealersource offline report",
  "type": "object",
  "required": ["schema_version", "run_id", "run_date", "offline", "providers", "sites", "evidence", "external_calls"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string", "minLength": 1 },
    "run_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "offline": { "type": "boolean" },
    "providers": {
      "type": "object",
      "required": ["paid_enabled", "geocoder", "parcels", "drivetime", "imagery", "poi", "crawler", "tiles"],
      "properties": {
        "paid_enabled": { "type": "boolean" },
        "geocoder": { "enum": ["census", "nominatim", "google"] },
        "parcels": { "enum": ["nc_onemap", "county", "regrid"] },
        "drivetime": { "enum": ["ors", "valhalla", "google"] },
        "imagery": { "enum": ["mapillary", "streetview"] },
        "poi": { "enum": ["overpass", "places"] },
        "crawler": { "enum": ["anycrawl", "anycrawl_cloud"] },
        "tiles": { "enum": ["protomaps", "mapbox"] }
      }
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["site_id", "parcel_id", "listing_ids", "address", "in_search_area", "shared_lot", "gates", "viable", "rank", "metrics", "open_cases"],
        "properties": {
          "site_id": { "type": "string" },
          "parcel_id": { "type": "string" },
          "listing_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "address": { "type": "string" },
          "in_search_area": { "type": "boolean" },
          "drive_minutes": { "type": ["number", "null"] },
          "shared_lot": { "type": "boolean" },
          "gates": {
            "type": "object",
            "required": ["zoning", "rent", "flood"],
            "properties": {
              "zoning": { "$ref": "#/$defs/gate" },
              "rent": { "$ref": "#/$defs/gate" },
              "flood": { "$ref": "#/$defs/gate" }
            }
          },
          "viable": { "type": "boolean" },
          "score": { "type": ["number", "null"] },
          "rank": { "type": ["integer", "null"], "minimum": 1 },
          "metrics": {
            "type": "object",
            "properties": {
              "aadt": { "type": ["number", "null"] },
              "visibility": { "type": ["number", "null"] },
              "drive_minutes": { "type": ["number", "null"] },
              "rent_monthly": { "type": ["number", "null"] },
              "competitors": { "type": ["number", "null"] }
            }
          },
          "open_cases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["case_type", "status", "recipient"],
              "properties": {
                "case_type": { "enum": ["rent", "zoning", "space"] },
                "status": { "type": "string" },
                "recipient": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "site_id", "fact", "value", "source_url", "fetched_at", "expires_at", "method"],
        "properties": {
          "evidence_id": { "type": "string" },
          "site_id": { "type": "string" },
          "fact": { "type": "string" },
          "source_url": { "type": "string", "minLength": 1 },
          "fetched_at": { "type": "string" },
          "expires_at": { "type": "string" },
          "method": { "type": "string" }
        }
      }
    },
    "external_calls": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": { "enum": ["pass", "fail", "pending"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

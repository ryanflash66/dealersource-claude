{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ryanflash66/dealersource/evals/contract/run.schema.json",
  "title": "dealersource run summary",
  "type": "object",
  "required": ["run_id", "run_date", "started_at", "finished_at", "counts", "errors"],
  "properties": {
    "run_id": { "type": "string" },
    "run_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "started_at": { "type": "string" },
    "finished_at": { "type": "string" },
    "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "errors": { "type": "array", "items": { "type": "string" } }
  }
}

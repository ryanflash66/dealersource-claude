# dealersource environment variables
# ---------------------------------------------------------------------------
# Every variable is OPTIONAL. When a variable is unset, the adapter that needs
# it falls back to its fixture-backed fake and the run is logged as such.
# Nothing here is required for `npm test` or `npm run pipeline:offline`.
# Never commit a real .env; only this example is tracked.

# --- Run behaviour ---------------------------------------------------------
DEALERSOURCE_OFFLINE=            # "1" forces offline/fixture mode (same as --offline)
DEALERSOURCE_NOW=                # ISO timestamp to freeze the clock (tests/replays); blank = real clock
DEALERSOURCE_STATE_DIR=          # where the JSON store keeps state when Supabase is not configured (default .dealersource)
DEALERSOURCE_HOME_BASE=          # overrides search.home_base at deploy time; the real dealership address is set here, never in the repo
LOG_LEVEL=                       # debug | info | warn | error (default info)

# --- Storage: Supabase (Postgres + PostGIS via PostgREST) -------------------
SUPABASE_URL=                    # https://<project>.supabase.co or http://localhost:3000 for the Docker PostgREST stack
SUPABASE_SERVICE_ROLE_KEY=       # pipeline writes (server side only, never shipped to the dashboard)
SUPABASE_ANON_KEY=               # dashboard reads (RLS-limited); baked into dashboard/public/config.js at build
DATABASE_URL=                    # postgres:// URL used only by scripts/apply-migrations.mjs (psql)

# --- Email: Gmail API via OAuth (verification outreach) --------------------
GMAIL_CLIENT_ID=                 # OAuth client id for the Gmail API app
GMAIL_CLIENT_SECRET=             # OAuth client secret
GMAIL_REFRESH_TOKEN=             # refresh token for the mailbox selected by mail.sender (owner or operator)
GMAIL_SENDER_ADDRESS=            # the mailbox address the token belongs to; also used as Reply-To

# --- Social: Reddit official Data API --------------------------------------
REDDIT_CLIENT_ID=                # script-type OAuth app id
REDDIT_CLIENT_SECRET=            # script-type OAuth app secret
REDDIT_USER_AGENT=               # e.g. "dealersource/0.1 by <reddit-username>" (required by Reddit API terms)

# --- Free providers that still need a key or a self-hosted URL -------------
ORS_API_KEY=                     # OpenRouteService free tier key (drive time)
MAPILLARY_ACCESS_TOKEN=          # Mapillary client token (street-level imagery)
NOMINATIM_URL=                   # self-hosted Nominatim base URL (never the public server)
VALHALLA_URL=                    # self-hosted Valhalla base URL
OVERPASS_URL=                    # self-hosted Overpass URL (defaults to a public instance with polite limits)
ANYCRAWL_URL=                    # self-hosted AnyCrawl base URL (crawler)
ANYCRAWL_API_KEY=                # AnyCrawl cloud key (PAID adapter, disabled by default)
PMTILES_URL=                     # self-hosted Protomaps PMTiles archive for the dashboard basemap

# --- PAID providers (all disabled unless providers.paid_enabled: true) ------
GOOGLE_MAPS_API_KEY=             # Google Geocoding / Address Validation / Distance Matrix / Street View / Places
REGRID_API_KEY=                  # Regrid parcels
ANTHROPIC_API_KEY=               # Claude API (llm: claude-api)
MAPBOX_TOKEN=                    # Mapbox tiles for the dashboard

# --- Deploy ----------------------------------------------------------------
VERCEL_TOKEN=                    # only used by `npm run dashboard:deploy` in CI

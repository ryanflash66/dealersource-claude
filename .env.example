# dealersource environment variables
# ---------------------------------------------------------------------------
# Every variable is OPTIONAL. When a variable is unset, the adapter that needs
# it falls back to its fixture-backed fake (with --fixtures) and the run
# records the layer under fixture_layers. Nothing here is required for
# `npm test` or the offline pipeline. Never commit a real .env.

# --- Run behaviour ---------------------------------------------------------
DEALERSOURCE_OFFLINE=            # "1" forces offline/fixture mode (same as --offline)
DEALERSOURCE_RUN_DATE=           # YYYY-MM-DD logical today (same as --run-date); blank = today in schedule.timezone
DEALERSOURCE_NOW=                # ISO instant to freeze the clock (replays/tests); blank = run-date 10:00Z or real clock
DEALERSOURCE_HOME_BASE=          # home base: the address drive times are measured from (where the owner commutes from); overrides business.yaml search.home_base at deploy
DEALERSOURCE_PAUSE_SENDING=      # "1" pauses ALL outbound email (kill switch; surfaced on the dashboard)
DEALERSOURCE_STATE_DIR=          # JSON store location when Supabase is not configured (default <out>/state)
LOG_LEVEL=                       # debug | info | warn | error (default info); logs are JSON lines on stderr

# --- Storage: Supabase (Postgres + PostGIS via PostgREST) -------------------
SUPABASE_URL=                    # https://<ref>.supabase.co, or http://localhost:3000 for the Docker PostgREST stack
SUPABASE_SERVICE_ROLE_KEY=       # pipeline writes (server side only; never shipped to the dashboard)
SUPABASE_ANON_KEY=               # dashboard reads (RLS-limited); embedded in dashboard/public/config.js at build
DATABASE_URL=                    # postgres:// URL used only by `npm run db:migrate` (psql)

# --- Email: Gmail SMTP + IMAP with an app password (verification outreach) --
GMAIL_SENDER_ADDRESS=            # the mailbox chosen by business.yaml mail.sender (owner|operator); sends via smtp.gmail.com:465, replies read via imap.gmail.com:993, also the Reply-To
GMAIL_APP_PASSWORD=              # 16-character Google app password for that mailbox (needs 2-Step Verification); spaces are ignored; never the account password

# --- Social: Reddit official Data API --------------------------------------
REDDIT_CLIENT_ID=                # script-type OAuth app id
REDDIT_CLIENT_SECRET=            # script-type OAuth app secret
REDDIT_USER_AGENT=               # e.g. "dealersource/0.1 by <reddit-username>" (required by Reddit API terms)

# --- Free providers that need a key or a self-hosted URL -------------------
ORS_API_KEY=                     # OpenRouteService free-tier key (drivetime: ors)
MAPILLARY_ACCESS_TOKEN=          # Mapillary client token (imagery: mapillary)
ANYCRAWL_URL=                    # only for crawler: anycrawl (self-hosted); the default crawler `fetch` needs nothing
NOMINATIM_URL=                   # self-hosted Nominatim base URL (geocoder: nominatim); the public server is refused
VALHALLA_URL=                    # self-hosted Valhalla base URL (drivetime: valhalla)
OVERPASS_URL=                    # Overpass instance(s) for poi: overpass; one URL or a comma-separated list tried in order. Default: overpass-api.de, then overpass.kumi.systems
PMTILES_URL=                     # optional override; the dashboard ships dashboard/public/tiles/eastern-nc.pmtiles (tiles: protomaps)

# --- PAID providers: unreachable unless providers.yaml paid_enabled: true ---
GOOGLE_MAPS_API_KEY=             # geocoder: google | drivetime: google | imagery: streetview | poi: places
REGRID_API_KEY=                  # parcels: regrid
ANTHROPIC_API_KEY=               # llm: claude_api
ANYCRAWL_API_KEY=                # crawler: anycrawl_cloud
MAPBOX_TOKEN=                    # tiles: mapbox

# --- Deploy ----------------------------------------------------------------
VERCEL_TOKEN=                    # only for `npm run dashboard:deploy` from CI

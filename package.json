{
  "name": "dealersource",
  "version": "0.1.0",
  "private": true,
  "description": "Finds, verifies and ranks leaseable sites for a used-car dealership in Eastern NC. Offline-first, provider-abstracted pipeline plus static dashboard.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx src/cli.ts run",
    "pipeline:offline": "tsx src/cli.ts run --offline",
    "sources:check": "tsx src/cli.ts sources check",
    "sources:discover": "tsx src/cli.ts sources discover",
    "dashboard:build": "tsc -p dashboard/tsconfig.json && node scripts/copy-dashboard-data.mjs",
    "dashboard:dev": "npm run dashboard:build && node scripts/serve-dashboard.mjs",
    "dashboard:deploy": "npm run dashboard:build && vercel deploy --prod --yes",
    "db:local": "docker compose up -d",
    "db:migrate": "node scripts/apply-migrations.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.13.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  }
}
